<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>puks</title>
<style>
:root{
  --bg:#222; --side:#1b1b1b; --head:#161616; --ink:#ddd; --mute:#999; --line:#444; --link:#5a8df0; --th:#555; --cell:#262626;
  --note:#2c2f36; --warn:#c33; --idea:#e0b840; --orange:#ff6a00; --code:#b9d6ff;
  box-sizing:border-box; padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-area-inset-bottom,0px) env(safe-area-inset-left,0px);
}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#fff;--side:#f6f6f6;--head:#eaecf0;--ink:#202122;--mute:#54595d;--line:#c8ccd1;--link:#0645ad;--th:#eaecf0;--cell:#fff;--note:#eef3fb;--code:#0b3d91}}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 Arial,Helvetica,sans-serif}
a{color:var(--link);text-decoration:none}a:hover{text-decoration:underline}
:focus-visible{outline:2px solid var(--orange);outline-offset:2px}

header{height:60px;background:var(--head) repeating-linear-gradient(135deg,transparent 0 3px,rgba(128,128,128,.08) 3px 4px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px}
header .site{font-size:22px;letter-spacing:.02em}
header .site b{font-weight:700}
header nav{font-size:12px;display:flex;gap:14px}
.layout{display:grid;grid-template-columns:176px 1fr;min-height:calc(100vh - 60px)}
aside{background:var(--side);border-right:1px solid var(--line);padding:30px 0 30px 26px;font-size:12.5px}
aside h4{margin:26px 0 8px;font-size:12.5px}
aside h4:first-child{margin-top:0}
aside a{display:block;padding:3px 0}
main{padding:0 24px 40px;min-width:0}

.tabs{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1px solid var(--line);height:34px;margin:14px 0 26px;font-size:13px}
.tabs span{padding:6px 10px;display:inline-block}
.tabs a{padding:6px 10px;display:inline-block;color:var(--link)}
.tabs .on{border-bottom:2px solid var(--ink);font-weight:700}
.tabs input{background:var(--cell);color:var(--ink);border:1px solid var(--line);padding:5px 8px;width:220px;font:inherit;font-size:12px;margin-bottom:2px}

h1{font:400 28px/1.2 Arial,sans-serif;margin:0 0 4px;padding-bottom:2px;border-bottom:1px solid var(--line)}
h2{font:400 21px/1.3 Arial,sans-serif;margin:34px 0 12px;border-bottom:1px solid var(--line);padding-bottom:3px}
.crumb{font-size:11px;margin:6px 0 20px;color:var(--mute)}
p{margin:0 0 10px}
code{font:12px Consolas,"Courier New",monospace;color:var(--code)}

.fig{float:right;margin:0 0 14px 22px;width:230px;border:1px solid var(--line);background:var(--cell)}
.fig .im{aspect-ratio:1;display:grid;place-items:center;color:var(--orange);font-size:22px;position:relative;background:linear-gradient(var(--line) 1px,transparent 1px) 0 0/100% 32px}
.fig .im::before{content:"";position:absolute;inset:14% 16%;border:1px solid var(--orange);transform:skew(-4deg)}
.fig figcaption{font-size:12px;padding:5px 7px;border-top:1px solid var(--line)}

.toc{display:inline-block;background:var(--cell);border:1px solid var(--line);padding:8px 16px 10px;font-size:13px;margin:6px 0 4px}
.toc b{display:block;text-align:center;margin-bottom:4px}
.toc ol{margin:0;padding-left:18px}.toc ol ol{padding-left:18px}

table{border-collapse:collapse;border:2px solid var(--line);background:var(--cell);margin:6px 0 14px;max-width:100%}
th{background:var(--th);padding:5px 9px;border:1px solid var(--mute);text-align:center}
td{padding:5px 9px;border:1px solid var(--mute);vertical-align:middle}
td.th{background:var(--th);font-weight:700}
.thumb{width:64px;height:44px;border:1px solid var(--line)}
tr[hidden]{display:none}
.tblwrap{overflow-x:auto}

.box{border-left:3px solid var(--mute);background:var(--note);padding:8px 12px;margin:14px 0;font-size:13.5px}
.box.warn{border-color:var(--warn)}.box.idea{border-color:var(--idea)}
.box b{font-weight:700}.warn b{color:#f44}.idea b{color:var(--idea)}
.clear{clear:both}
.cmt{border:1px solid var(--line);background:var(--cell);padding:8px 12px;margin:0 0 10px;max-width:640px}
.cmt .h{font-size:12px;color:var(--mute);display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:3px}
.cmt .h b{color:var(--ink)}.cmt .st{color:var(--orange);letter-spacing:1px}
.cmt p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}
form.cf{max-width:640px;border:1px solid var(--line);background:var(--cell);padding:12px;margin:14px 0}
form.cf label{display:block;font-size:12px;color:var(--mute);margin:8px 0 3px}
form.cf input,form.cf select,form.cf textarea{width:100%;background:var(--bg);color:var(--ink);border:1px solid var(--line);padding:6px 8px;font:inherit}
form.cf textarea{min-height:90px;resize:vertical}
form.cf .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
form.cf button{margin-top:10px;background:var(--th);color:var(--ink);border:1px solid var(--mute);padding:6px 16px;font:inherit;cursor:pointer}
.hp{position:absolute;left:-9999px;height:0;width:0;overflow:hidden}
#avg{font-size:13px;margin:0 0 10px;color:var(--mute)}
.viewer{border:1px solid var(--line);background:var(--cell);max-width:640px}
.viewer .passes{display:flex;flex-wrap:wrap;border-bottom:1px solid var(--line)}
.viewer .passes button{background:var(--th);color:var(--ink);border:0;border-right:1px solid var(--line);padding:6px 12px;font:inherit;font-size:13px;cursor:pointer}
.viewer .passes button[aria-pressed="true"]{background:var(--bg);font-weight:700;box-shadow:inset 0 -2px var(--orange)}
.viewer .lbl{padding:6px 10px;font-size:12px;color:var(--mute);border-right:1px solid var(--line);background:var(--side)}
.viewer canvas{display:block;width:100%;aspect-ratio:4/3;background:radial-gradient(circle at 50% 40%,#2a2a3a,#0a0a12);touch-action:none;cursor:grab}
.viewer .cap{padding:5px 8px;font-size:12px;border-top:1px solid var(--line);color:var(--mute)}
footer{margin-top:40px;padding-top:12px;border-top:1px solid var(--line);font-size:12px;color:var(--mute)}

dialog{background:var(--bg);color:var(--ink);border:1px solid var(--mute);padding:0;width:min(560px,94vw)}
dialog::backdrop{background:rgba(0,0,0,.6)}
dialog .im{min-height:220px;max-height:72vh;display:grid;place-items:center;overflow:hidden}
#dimg{max-width:100%;max-height:72vh;object-fit:contain;display:block}
#dimg[hidden]{display:none}
dialog .in{padding:10px 14px 14px}
dialog h3{margin:0 0 6px;font:400 20px Arial,sans-serif}
dialog button{background:var(--th);color:var(--ink);border:1px solid var(--mute);padding:4px 12px;font:inherit;cursor:pointer}

@media (max-width:760px){
  .layout{grid-template-columns:1fr}
  aside{border-right:0;border-bottom:1px solid var(--line);padding:12px 16px;display:flex;flex-wrap:wrap;gap:4px 16px}
  aside h4{display:none}
  main{padding:0 14px 30px}
  .tabs input{width:140px}
  .fig{float:none;margin:0 0 14px;width:100%;max-width:260px}
  header{padding:0 14px}
}

.filters{display:flex;margin:0 0 12px}
.filters button{background:var(--cell);color:var(--ink);border:1px solid var(--line);margin-left:-1px;padding:5px 14px;font:inherit;font-size:13px;cursor:pointer}
.filters button:first-child{margin-left:0}
.filters button[aria-pressed="true"]{background:var(--th);font-weight:700;box-shadow:inset 0 -2px var(--orange)}
.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.gi{display:block;border:1px solid var(--line);background:var(--cell);padding:0;text-align:left;font:inherit;color:inherit;cursor:pointer}
.gi:hover{border-color:var(--link)}
.gi[hidden]{display:none}
.gi .art{aspect-ratio:4/5;overflow:hidden}
.gi img{width:100%;height:100%;object-fit:cover;display:block}
.gi img[hidden]{display:none}
.gi .cap{padding:6px 8px;font-size:12.5px;border-top:1px solid var(--line)}
.gi small{display:block;color:var(--mute);font-size:11.5px}
.thumb{width:60px;height:75px;overflow:hidden}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb img[hidden]{display:none}
#tbl{width:100%}
#tbl tbody tr{cursor:pointer}
#tbl tbody tr:hover td{background:var(--note)}
.opend{background:var(--th);color:var(--ink);border:1px solid var(--mute);padding:7px 16px;font:inherit;cursor:pointer;margin:2px 0 10px}
dialog.dw{width:min(780px,96vw);max-height:90vh;padding:0}
dialog.dw[open]{display:flex;flex-direction:column}
.dbar{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--line);background:var(--head) repeating-linear-gradient(135deg,transparent 0 3px,rgba(128,128,128,.08) 3px 4px)}
.dbar h3{font:700 15px Arial,sans-serif;margin:0}
.dbar button{background:none;border:0;color:var(--ink);font-size:22px;line-height:1;cursor:pointer;padding:0 6px}
.dscroll{overflow:auto;padding:12px 16px 18px}
.mut{font-size:13px;color:var(--mute);margin-bottom:6px}
.tool{display:flex;gap:8px;align-items:center;font-size:12px;color:var(--mute);margin:8px 0 6px}
.tool select{background:var(--cell);color:var(--ink);border:1px solid var(--line);padding:3px 6px;font:inherit}
.th{margin:10px 0}
.th>.hd{font-size:12px;color:var(--mute);display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.th>.hd b{color:var(--ink)}
.th>.hd button{background:none;border:0;color:var(--mute);cursor:pointer;font:inherit;padding:0}
.st{color:var(--orange);letter-spacing:1px}
.badge{background:var(--orange);color:#111;padding:0 5px;font-size:11px;font-weight:700}
.th .tx{margin:3px 0 4px;white-space:pre-wrap;overflow-wrap:anywhere}
.th .ac{display:flex;gap:6px;font-size:12px;align-items:center;color:var(--mute)}
.th .ac button{background:none;border:0;color:var(--mute);cursor:pointer;font:inherit;padding:2px 5px}
.th .ac button:hover{color:var(--ink)}
.th .ac button[aria-pressed="true"]{color:var(--orange);font-weight:700}
.kids{margin-left:5px;padding-left:14px;border-left:2px solid var(--line)}
.kids:hover{border-left-color:var(--mute)}
.kids.flat{margin-left:0;padding-left:6px}
.th.col>.tb{display:none}
.opend{display:inline-block;text-decoration:none}
.tabs .tab{background:none;border:0;border-bottom:2px solid transparent;color:var(--link);font:inherit;padding:6px 10px;cursor:pointer}
.tabs .tab:hover{text-decoration:underline}
.tabs .tab.on{color:var(--ink);border-bottom-color:var(--ink);font-weight:700}
.view{transition:opacity .18s ease,transform .18s ease}
.view.out{opacity:0;transform:translateY(8px)}
.view[hidden]{display:none}
@media (prefers-reduced-motion:reduce){.view{transition:none}}
.doodle::before{display:none}
.doodle canvas{width:100%;height:100%;display:block}
table.wide{width:100%}
table.wide td{vertical-align:top}
table.skills td{vertical-align:top;min-width:150px}
td ul{margin:0;padding-left:18px}
#tag{color:var(--mute);font-size:16px;transition:opacity .35s ease}
#tag.fade{opacity:0}
header .sep{color:var(--mute)}
#pager{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;font-size:12px;color:var(--mute);margin:-4px 0 14px}
.pnav{display:flex}
.pnav button{background:var(--cell);color:var(--ink);border:1px solid var(--line);margin-left:-1px;padding:4px 11px;font:inherit;cursor:pointer}
.pnav button:first-child{margin-left:0}
.pnav button[aria-current]{background:var(--th);font-weight:700;box-shadow:inset 0 -2px var(--orange)}
.pnav button:disabled{opacity:.4;cursor:default}
@media (prefers-reduced-motion:reduce){#tag{transition:none}}

/* ---------- mobile and small screens ---------- */
html{-webkit-text-size-adjust:100%}
img,svg,canvas{max-width:100%}
main{overflow-wrap:break-word}
td{overflow-wrap:anywhere}
table td.mo{display:none}
.filters{flex-wrap:wrap}
@media (max-width:760px){
  html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 54px)}
  header .site{display:block;padding:12px 14px 10px;line-height:1.25}
  header .site b{font-size:20px}
  header .sep{display:none}
  #tag{display:block;font-size:14px;margin-top:2px}
  header nav{padding:0 6px}
  header nav a{padding:12px 10px}
  aside{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;display:flex;flex-wrap:nowrap;overflow-x:auto;white-space:nowrap;gap:0;padding:0 6px;background:var(--side);-webkit-overflow-scrolling:touch}
  aside h4,aside .hm{display:none}
  aside a{padding:13px 12px;flex:0 0 auto}
  main{padding:0 14px 30px}
  h1{font-size:24px}
  h2{font-size:19px;margin-top:28px}
  .tabs{height:auto;flex-wrap:wrap;gap:6px;margin:10px 0 18px}
  .tabs input{width:100%;order:3;font-size:16px;padding:9px 10px;margin-bottom:6px}
  .tabs .tab{padding:10px 12px}
  .fig{float:none;width:100%;max-width:260px;margin:0 auto 16px}
  .toc{display:block}
  /* work table becomes a list of cards */
  #tbl thead{display:none}
  #tbl,#tbl tbody{display:block;border:0}
  #tbl tbody tr{display:grid;grid-template-columns:64px 1fr;column-gap:12px;align-items:start;padding:10px;border:1px solid var(--line);border-bottom:0;background:var(--cell)}
  #tbl tbody tr:last-child{border-bottom:1px solid var(--line)}
  #tbl tbody tr[hidden]{display:none}
  #tbl td{display:block;border:0;padding:0}
  #tbl td:nth-child(1){grid-row:1 / span 3}
  #tbl td:nth-child(2){font-weight:700;font-size:15px}
  #tbl td:nth-child(3),#tbl td:nth-child(4){font-size:12px;color:var(--mute)}
  .thumb{width:64px;height:80px}
  .filters button{padding:9px 16px}
  #pager{flex-direction:column;align-items:flex-start}
  .pnav button{padding:9px 14px}
  /* experience and education become stacked cards */
  table.wide{display:block;border:0}
  table.wide thead{display:none}
  table.wide tbody{display:block}
  table.wide tr{display:block;border:1px solid var(--line);margin:0 0 10px;padding:8px 10px;background:var(--cell)}
  table.wide td{display:block;border:0;padding:3px 0;min-width:0}
  table.wide td::before{content:attr(data-l);display:block;font-size:11px;color:var(--mute)}
  table.wide td:empty{display:none}
  table.wide td.mo{display:block}
  /* skills stack */
  table.skills{display:block;border:0}
  table.skills thead{display:none}
  table.skills tbody,table.skills tr{display:block}
  table.skills td{display:block;border:1px solid var(--line);border-bottom:0;min-width:0}
  table.skills td:last-child{border-bottom:1px solid var(--line)}
  table.skills td::before{content:attr(data-l);display:block;font-weight:700;margin-bottom:4px}
  table.skills td ul{column-count:2;column-gap:16px}
  /* 3D viewer */
  .viewer .passes button{padding:9px 12px}
  .viewer canvas{touch-action:pan-y}
  /* discussion */
  form.cf .row{grid-template-columns:1fr}
  form.cf input,form.cf select,form.cf textarea,.tool select{font-size:16px}
  form.cf button,.opend{padding:10px 18px}
  .kids{padding-left:10px;margin-left:2px}
  .th .ac button{padding:6px 9px}
  .th>.hd button{padding:4px 6px}
  dialog{width:94vw}
  #dimg{max-height:60vh}
  footer{flex-direction:column}
}
@media (max-width:380px){
  table.skills td ul{column-count:1}
  #tbl tbody tr{grid-template-columns:56px 1fr}
  .thumb{width:56px;height:70px}
}
.lnk{background:none;border:0;color:var(--link);font:inherit;cursor:pointer;padding:0;text-decoration:underline}
</style>
</head>
