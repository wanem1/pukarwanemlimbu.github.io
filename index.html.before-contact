<script defer src="discussion.js"></script>
<script>
const W=SITE.projects.map((p,i)=>({n:p.title,t:p.type,k:p.tags,img:SITE.imageFolder+p.image,bg:`linear-gradient(135deg,hsl(${(i*47)%360} 60% 32%),hsl(${(i*47+70)%360} 55% 18%))`}));
const $=s=>document.querySelector(s),g=$('#tbl tbody'),dlg=$('#dlg'),dimg=$('#dimg');
g.innerHTML=W.map((w,i)=>`<tr data-i="${i}" data-t="${w.t}"><td><div class="thumb" style="background:${w.bg}"><img src="${w.img}" alt="${w.n}" loading="lazy"></div></td><td><a href="#">${w.n}</a></td><td>${w.t}</td><td>${w.k}</td></tr>`).join('');
g.addEventListener('error',e=>{if(e.target.tagName==='IMG')e.target.hidden=true},true);
dimg.addEventListener('error',()=>dimg.hidden=true);
g.onclick=e=>{const b=e.target.closest('tr');if(!b)return;e.preventDefault();const w=W[b.dataset.i];
  $('#di').style.background=w.bg;dimg.hidden=false;dimg.src=w.img;dimg.alt=w.n;$('#dt').textContent=w.n;$('#dp').textContent=w.t+'. '+w.k+'.';
  dlg.showModal?dlg.showModal():dlg.setAttribute('open','')};
$('#dx').onclick=()=>dlg.close?dlg.close():dlg.removeAttribute('open');
dlg.onclick=e=>{if(e.target===dlg)dlg.close()};
let cat='all',pg=1;const PER=6;
function f(reset){
  if(reset)pg=1;
  const q=$('#q').value.toLowerCase(),rows=[...g.querySelectorAll('tr')];
  const m=rows.filter(r=>(cat==='all'||r.dataset.t===cat)&&r.textContent.toLowerCase().includes(q));
  const pages=Math.max(1,Math.ceil(m.length/PER));if(pg>pages)pg=pages;
  rows.forEach(r=>r.hidden=true);
  m.slice((pg-1)*PER,pg*PER).forEach(r=>r.hidden=false);
  const pr=$('#pager');pr.textContent='';
  if(!m.length){pr.textContent='No projects match.';return}
  const info=document.createElement('span');
  info.textContent='Showing '+((pg-1)*PER+1)+' to '+Math.min(pg*PER,m.length)+' of '+m.length;pr.appendChild(info);
  if(pages>1){const nav=document.createElement('div');nav.className='pnav';
    const mk=(label,n,dis,cur,al)=>{const b=document.createElement('button');b.type='button';b.textContent=label;if(al)b.setAttribute('aria-label',al);if(dis)b.disabled=true;if(cur)b.setAttribute('aria-current','page');b.onclick=()=>{pg=n;f()};return b};
    nav.appendChild(mk('Prev',pg-1,pg===1));
    for(let i=1;i<=pages;i++)nav.appendChild(mk(String(i),i,false,i===pg,'Page '+i));
    nav.appendChild(mk('Next',pg+1,pg===pages));pr.appendChild(nav)}
}
$('#q').oninput=()=>f(true);
document.querySelectorAll('[data-cat]').forEach(b=>b.onclick=()=>{cat=b.dataset.cat;document.querySelectorAll('.filters button').forEach(x=>x.setAttribute('aria-pressed',x.dataset.cat===cat));f(true)});
f();
(function(){
  const T=SITE.taglines,e=$('#tag');
  if(e&&T&&T.length)e.textContent=T[0];
  if(!e||!T||T.length<2||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let i=0;setInterval(()=>{e.classList.add('fade');setTimeout(()=>{i=(i+1)%T.length;e.textContent=T[i];e.classList.remove('fade')},350)},4500);
})();

(function(){
  const el=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e};
  document.querySelectorAll('a[data-email]').forEach(a=>{a.href='mailto:'+SITE.email;if(!a.hasAttribute('data-label'))a.textContent=SITE.email});
  const ab=$('#about-body');
  SITE.about.paragraphs.forEach(t=>ab.appendChild(el('p',null,t)));
  const at=el('table');
  [['Role',SITE.about.role],['Based in',SITE.about.location],['Email',null],['Available for',SITE.about.availability]].forEach(([k,v])=>{
    const r=el('tr');r.appendChild(el('td','th',k));const c=el('td');
    if(v===null){const a=el('a',null,SITE.email);a.href='mailto:'+SITE.email;c.appendChild(a)}else c.textContent=v;
    r.appendChild(c);at.appendChild(r)});
  ab.appendChild(at);
  const ex=$('#exp'),run=(a,i)=>{let n=1;while(a[i+n]&&a[i+n].org===a[i].org)n++;return n};
  const cell=(t,l,c)=>{const e=el('td',c||null,t);e.dataset.l=l;return e};
  SITE.experience.forEach((x,i,a)=>{
    const r=el('tr'),first=i===0||a[i-1].org!==x.org;
    let g=i;while(g>0&&a[g-1].org===x.org)g--;
    const yrs=x.years||a[g].years;
    if(first){const c=cell(x.org,'Organization');c.rowSpan=run(a,i);r.appendChild(c)}else r.appendChild(cell(x.org,'Organization','mo'));
    r.appendChild(cell(x.role,'Role'));
    if(first){const c=cell(yrs,'Years');c.rowSpan=run(a,i);r.appendChild(c)}else r.appendChild(cell(yrs,'Years','mo'));
    r.appendChild(cell(x.details,'Details'));ex.appendChild(r)});
  SITE.education.forEach(x=>{const r=el('tr');[[x.qualification,'Qualification'],[x.institution,'Institution'],[x.years,'Years'],[x.notes,'Notes']].forEach(p=>r.appendChild(cell(p[0],p[1])));$('#edu').appendChild(r)});
  [['software','Software proficiency'],['technical','Technical skills'],['soft','Soft skills']].forEach(p=>{const c=cell('',p[1]),u=el('ul');SITE.skills[p[0]].forEach(v=>u.appendChild(el('li',null,v)));c.appendChild(u);$('#skl').appendChild(c)});
  SITE.certificates.forEach(x=>{const r=el('tr');r.appendChild(el('td',null,x.provider));r.appendChild(el('td',null,x.title));$('#cert').appendChild(r)});
})();
(function(){
  const cv=$('#gl'),mb=$('#models'),pb=$('#passes');
  if(!window.THREE){cv.outerHTML='<p style="padding:10px">The 3D library did not load.</p>';return}
  const T=THREE,r=new T.WebGLRenderer({canvas:cv,antialias:true,alpha:true});r.setPixelRatio(Math.min(devicePixelRatio,2));
  const sc=new T.Scene(),cam=new T.PerspectiveCamera(40,4/3,.1,100);cam.position.z=4.6;
  sc.add(new T.HemisphereLight(0xffffff,0x223355,.9));const dl=new T.DirectionalLight(0xffffff,.9);dl.position.set(3,4,5);sc.add(dl);
  const SHAPES={
    knot:()=>[new T.TorusKnotGeometry(1,.32,140,20),new T.TorusKnotGeometry(1,.32,40,6)],
    sphere:()=>[new T.SphereGeometry(1.3,64,48),new T.SphereGeometry(1.3,10,7)],
    cube:()=>[new T.BoxGeometry(1.9,1.9,1.9,10,10,10),new T.BoxGeometry(1.9,1.9,1.9)],
    torus:()=>[new T.TorusGeometry(1.1,.42,40,72),new T.TorusGeometry(1.1,.42,8,12)],
    cone:()=>[new T.ConeGeometry(1.3,2.4,64,12),new T.ConeGeometry(1.3,2.4,8,1)]};
  const PASS={Beauty:null,
    Clay:new T.MeshStandardMaterial({color:0xbdb5aa,roughness:1}),
    Wire:new T.MeshBasicMaterial({color:0x7dffb2,wireframe:true}),
    Normals:new T.MeshNormalMaterial(),
    Flat:new T.MeshStandardMaterial({color:0x5ad1ff,flatShading:true,roughness:.6})};
  const BEAUTY=new T.MeshStandardMaterial({color:0xff6a00,metalness:.35,roughness:.3});
  const models=SITE.models,cache={},root=new T.Group();sc.add(root);
  let mi=0,pass='Beauty',cur=null,token=0;
  const tri=o=>{let n=0;o.traverse(m=>{if(m.isMesh){const g=m.geometry;n+=(g.index?g.index.count:g.attributes.position.count)/3}});return Math.round(n).toLocaleString()};
  function shape(n,fail){const p=(SHAPES[n]||SHAPES.knot)(),m=new T.Mesh(p[0],BEAUTY);m.userData={orig:BEAUTY,hi:p[0],lo:p[1]};const g=new T.Group();g.add(m);g.userData.fail=fail||false;return g}
  function normalize(o){const b=new T.Box3().setFromObject(o),c=b.getCenter(new T.Vector3()),s=b.getSize(new T.Vector3());
    const k=2.6/(Math.max(s.x,s.y,s.z)||1);o.position.sub(c);const g=new T.Group();g.add(o);g.scale.setScalar(k);
    g.traverse(x=>{if(x.isMesh)x.userData.orig=x.material});return g}
  function load(i){return cache[i]||(cache[i]=new Promise(res=>{
    const m=models[i];
    if(!m.file){res(shape(m.shape));return}
    if(!T.GLTFLoader){res(shape('knot',m.file));return}
    new T.GLTFLoader().load(m.file,g=>res(normalize(g.scene)),undefined,()=>res(shape('knot',m.file)))}))}
  function apply(){if(!cur)return;cur.traverse(x=>{if(!x.isMesh)return;const u=x.userData;
    if(u.hi)x.geometry=pass==='Flat'?u.lo:u.hi;x.material=pass==='Beauty'?u.orig:PASS[pass]})}
  function cap(){const m=models[mi];let t=m.name+', '+pass+' pass, '+tri(cur)+' triangles.';
    if(cur.userData.fail)t+=' Could not load '+cur.userData.fail+', showing a placeholder.';
    else if(!m.file)t+=' Placeholder shape. Add a .glb file in content.js to show your own model.';
    $('#glcap').textContent=t}
  async function select(i){const my=++token;mi=i;$('#glcap').textContent='Loading '+models[i].name+'...';
    const o=await load(i);if(my!==token)return;if(cur)root.remove(cur);cur=o;root.add(o);apply();cap()}
  const btns=(host,keys,label,sel,on)=>{host.textContent='';const l=document.createElement('span');l.className='lbl';l.textContent=label;host.appendChild(l);
    keys.forEach((k,i)=>{const b=document.createElement('button');b.type='button';b.textContent=k;b.setAttribute('aria-pressed',i===sel);b.onclick=()=>{
      host.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',x===b));on(i,k)};host.appendChild(b)})};
  btns(mb,models.map(m=>m.name),'Model',0,i=>select(i));
  btns(pb,Object.keys(PASS),'Pass',0,(i,k)=>{pass=k;apply();if(cur)cap()});
  function size(){const w=cv.clientWidth;if(w)r.setSize(w,Math.round(w*.75),false)}
  size();addEventListener('resize',size);
  let d=null,vis=true;const calm=matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver)new IntersectionObserver(e=>vis=e[0].isIntersecting).observe(cv);
  cv.onpointerdown=e=>{d=[e.clientX,e.clientY];cv.setPointerCapture(e.pointerId);cv.style.cursor='grabbing'};
  cv.onpointermove=e=>{if(!d)return;root.rotation.y+=(e.clientX-d[0])*.01;root.rotation.x+=(e.clientY-d[1])*.01;d=[e.clientX,e.clientY]};
  cv.onpointerup=cv.onpointercancel=()=>{d=null;cv.style.cursor='grab'};
  (function loop(){if(vis){if(!d&&!calm)root.rotation.y+=.008;r.render(sc,cam)}requestAnimationFrame(loop)})();
  select(0);
})();
(function(){
  const c=document.getElementById('bp');
  if(!c||!c.getContext)return;
  const S=280,dpr=Math.min(window.devicePixelRatio||1,2),x=c.getContext('2d');
  c.width=c.height=S*dpr;x.scale(dpr,dpr);
  const calm=matchMedia('(prefers-reduced-motion:reduce)').matches;
  const BG='#0d3b73',MINOR='rgba(150,195,255,.16)',MAJOR='rgba(150,195,255,.34)',INK='#d6e9ff',ACC='#ffb36b';

  /* ---- build a tube around a (2,3) torus knot ---- */
  const N=84,M=8,R=.24,rings=[];
  const knot=t=>{const r=1+.45*Math.cos(3*t);return[r*Math.cos(2*t),r*Math.sin(2*t),.55*Math.sin(3*t)]};
  const norm=v=>{const l=Math.hypot(v[0],v[1],v[2])||1;return[v[0]/l,v[1]/l,v[2]/l]};
  const cross=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];
  for(let i=0;i<N;i++){
    const t=i/N*Math.PI*2,e=.01,p=knot(t),a=knot(t-e),b=knot(t+e);
    const T=norm([b[0]-a[0],b[1]-a[1],b[2]-a[2]]),B=norm(cross(T,[0,0,1])),Nn=cross(B,T),ring=[];
    for(let k=0;k<M;k++){const q=k/M*Math.PI*2,cq=Math.cos(q)*R,sq=Math.sin(q)*R;
      ring.push([p[0]+cq*B[0]+sq*Nn[0],p[1]+cq*B[1]+sq*Nn[1],p[2]+cq*B[2]+sq*Nn[2]])}
    rings.push(ring)}

  /* ---- rotate + perspective ---- */
  function proj(p,ay,ax){
    const X=p[0]*Math.cos(ay)+p[2]*Math.sin(ay),Z=-p[0]*Math.sin(ay)+p[2]*Math.cos(ay),Y=p[1];
    const Y2=Y*Math.cos(ax)-Z*Math.sin(ax),Z2=Y*Math.sin(ax)+Z*Math.cos(ax),s=4.2/(4.2-Z2)*52;
    return[S/2+X*s,S/2-Y2*s-8,Z2]}

  const link=(a,b)=>{x.beginPath();for(let k=0;k<M;k++){x.moveTo(a[k][0],a[k][1]);x.lineTo(b[k][0],b[k][1])}x.stroke()};

  function frame(time){
    const cyc=9,t=time%cyc,rv=calm?1:Math.min(1,t/3),fade=calm?1:(t>8?9-t:1);   /* draw-in 3s, hold, fade-out 1s, repeat */
    const ay=calm?.9:time*.55,ax=.62;
    x.globalAlpha=1;x.fillStyle=BG;x.fillRect(0,0,S,S);

    /* blueprint grid */
    x.lineWidth=1;
    [[MINOR,0],[MAJOR,1]].forEach(([col,major])=>{x.strokeStyle=col;x.beginPath();
      for(let g=0;g<=S;g+=14){if((g%56===0)!==!!major)continue;x.moveTo(g+.5,0);x.lineTo(g+.5,S);x.moveTo(0,g+.5);x.lineTo(S,g+.5)}x.stroke()});
    x.strokeStyle=INK;x.globalAlpha=.6;x.strokeRect(8.5,8.5,S-17,S-17);

    /* wireframe knot */
    const P=rings.map(r=>r.map(p=>proj(p,ay,ax))),lim=Math.max(2,Math.floor(rv*N));
    x.strokeStyle=INK;x.lineJoin='round';
    for(let i=0;i<lim;i++){
      const r=P[i],zc=r.reduce((a,p)=>a+p[2],0)/M,depth=Math.min(1,Math.max(0,(zc+1.9)/3.8));
      x.globalAlpha=(.2+.8*depth)*fade;
      x.beginPath();r.forEach((p,k)=>k?x.lineTo(p[0],p[1]):x.moveTo(p[0],p[1]));x.closePath();x.stroke();
      if(i>0)link(P[i-1],r)}
    if(rv>=1){x.globalAlpha=.5*fade;link(P[N-1],P[0])}

    /* orange scan line while the drawing builds */
    if(rv<1){const sx=16+rv*(S-32);x.globalAlpha=.85;x.strokeStyle=ACC;x.beginPath();x.moveTo(sx,14);x.lineTo(sx,S-14);x.stroke()}

    /* dimension line */
    x.globalAlpha=1;x.strokeStyle=ACC;x.fillStyle=INK;x.font='9px monospace';x.textAlign='center';
    const dy=S-54;
    x.beginPath();x.moveTo(34,dy);x.lineTo(S-34,dy);x.moveTo(34,dy-5);x.lineTo(34,dy+5);x.moveTo(S-34,dy-5);x.lineTo(S-34,dy+5);
    x.moveTo(34,dy);x.lineTo(42,dy-3);x.moveTo(34,dy);x.lineTo(42,dy+3);x.moveTo(S-34,dy);x.lineTo(S-42,dy-3);x.moveTo(S-34,dy);x.lineTo(S-42,dy+3);x.stroke();
    x.fillStyle=BG;x.fillRect(S/2-24,dy-6,48,12);x.fillStyle=INK;x.fillText('\u00D8 3.40',S/2,dy+3);

    /* callout A */
    x.strokeStyle=ACC;x.beginPath();x.arc(S-40,40,9,0,Math.PI*2);x.moveTo(S-47,46);x.lineTo(S/2+34,S/2-34);x.stroke();
    x.fillStyle=INK;x.fillText('A',S-40,43);

    /* title block */
    x.strokeStyle=INK;x.globalAlpha=.8;x.strokeRect(S-124,S-40,112,26);x.beginPath();x.moveTo(S-124,S-27);x.lineTo(S-12,S-27);x.stroke();
    x.globalAlpha=1;x.textAlign='left';x.fillText('WIREFRAME  REV 03',S-119,S-31);x.fillText('SCALE 1:1   SHEET 1/1',S-119,S-18);
    x.globalAlpha=1}

  let vis=true;
  if(window.IntersectionObserver)new IntersectionObserver(e=>{vis=e[0].isIntersecting}).observe(c);
  if(calm){frame(4);return}
  const t0=performance.now();
  (function loop(n){if(vis&&!document.hidden)frame((n-t0)/1000);requestAnimationFrame(loop)})(t0);
})();
</script>
